{
  "name": "youtubemusicapi.js",
  "description": "A lightweight, zero-dependency JavaScript port of ytmusicapi for Node.js, Bun, and Deno.",
  "type": "module",
  "module": "src/index.js",
  "main": "./src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "ytmusicapi": "./bin/setup.js"
  },
  "files": [
    "src",
    "types",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "youtube-music",
    "ytmusicapi",
    "ytmusic",
    "innertube",
    "bun",
    "deno"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p jsconfig.json",
    "prepublishOnly": "bun run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "version": "1.0.0"
}
